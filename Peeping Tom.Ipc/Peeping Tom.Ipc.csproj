<Project Sdk="Dalamud.NET.Sdk/13.0.0">
  <PropertyGroup>
    <Version>1.0.1</Version>
    <RootNamespace>PeepingTom.Ipc</RootNamespace>
    <Use_DalamudPackager>false</Use_DalamudPackager>
    <Use_Dalamud_ImGui>false</Use_Dalamud_ImGui>
    <Use_Dalamud_Serilog>false</Use_Dalamud_Serilog>
    <Use_Dalamud_MSObjectPool>false</Use_Dalamud_MSObjectPool>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>PeepingTom.Ipc</PackageId>
    <Title>PeepingTom.Ipc</Title>
    <Authors>ascclemens</Authors>
    <RepositoryUrl>https://git.anna.lgbt/ascclemens/PeepingTom</RepositoryUrl>
    <Description>Types for IPC with the Dalamud plugin Peeping Tom.</Description>
    <PackageLicenseExpression>EUPL-1.2</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup>
    <DalamudCnLibPath>$(AppData)\XIVLauncherCN\addon\Hooks\dev\</DalamudCnLibPath>
    <DalamudLibPath Condition="$([MSBuild]::IsOSPlatform('Windows')) AND !Exists('$(DalamudLibPath)') AND Exists('$(DalamudCnLibPath)')"
      >$(DalamudCnLibPath)</DalamudLibPath>
  </PropertyGroup>
</Project>
